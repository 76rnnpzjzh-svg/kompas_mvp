# Скопируйте в .env и заполните. Файл .env в репозиторий НЕ попадает (.gitignore).
# По умолчанию демо работает без ключей:
KOMPAS_LLM=extractive

# Вариант 1: GigaChat API
# KOMPAS_LLM=gigachat
# GIGACHAT_CREDENTIALS=        # ключ авторизации из личного кабинета, не коммитить
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=          # путь к сертификату НУЦ Минцифры

# Вариант 2: модель в своём контуре (vLLM / Ollama / открытые веса GigaChat или Qwen)
# KOMPAS_LLM=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
